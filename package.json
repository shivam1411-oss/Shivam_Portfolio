{
  "name": "shivam-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/gen-learn-catalog.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/gen-learn-catalog.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "apk": "node scripts/bump-android-version.mjs && npm run build && cap sync android && node scripts/remove-icloud-duplicates.mjs android/app/src && cd android && JAVA_HOME='/Applications/Android Studio.app/Contents/jbr/Contents/Home' ./gradlew assembleDebug && mkdir -p ../apk && cp ~/Library/Caches/ShivamPortfolioAndroid/app/outputs/apk/debug/app-debug.apk ../apk/Shivam-Soni-Portfolio.apk"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emailjs/browser": "^4.4.1",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.460.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "^4.10.38",
    "pyodide": "^0.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
